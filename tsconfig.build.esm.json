    "moduleResolution": "bundler",
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
