{
  "name": "idnumbers",
  "version": "2.1.1",
  "description": "A TypeScript library for verifying and parsing national ID numbers - supports 85 countries across 6 continents including USA, UK, France, Germany, Japan, China, India, Brazil, and many more",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./countries/*": {
      "import": {
        "types": "./dist/esm/countries/*/index.d.ts",
        "default": "./dist/esm/countries/*/index.js"
      },
      "require": {
        "types": "./dist/cjs/countries/*/index.d.ts",
        "default": "./dist/cjs/countries/*/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/cjs/core.d.ts"
      ],
      "countries/*": [
        "./dist/cjs/countries/*/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/cjs/index.js",
    "./dist/esm/index.js",
    "./dist/cjs/registry/registerAll.js",
    "./dist/esm/registry/registerAll.js"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/write-dist-markers.mjs",
    "dev": "tsc -p tsconfig.build.cjs.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:package": "publint && attw --pack . --include-entrypoints ./countries/twn ./countries/bgd ./countries/smr ./countries/lka",
    "lint:types": "node scripts/check-declarations.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "example": "npm run build && tsx examples/basic-usage.ts",
    "example:extended": "npm run build && tsx examples/basic-usage-extended.ts",
    "test:pack": "node scripts/smoke-pack.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "parity": "node scripts/parity/check-parity.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "prepare": "husky"
  },
  "keywords": [
    "id",
    "identification",
    "validation",
    "national-id",
    "ssn",
    "medicare",
    "nino",
    "sin",
    "tax-id",
    "typescript",
    "verification",
    "usa",
    "australia",
    "south-africa",
    "united-kingdom",
    "canada",
    "germany",
    "france",
    "netherlands",
    "albania",
    "austria",
    "belgium",
    "italy",
    "spain",
    "denmark",
    "poland",
    "czech-republic",
    "finland",
    "social-security",
    "national-insurance",
    "social-insurance",
    "fiscal-code",
    "dni",
    "cpr",
    "bsn",
    "atin",
    "pesel",
    "hetu",
    "birth-number"
  ],
  "author": "Identique",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/identique/idnumbers-npm.git"
  },
  "bugs": {
    "url": "https://github.com/identique/idnumbers-npm/issues"
  },
  "homepage": "https://github.com/identique/idnumbers-npm#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.49.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.0.3",
    "publint": "^0.3.24",
    "ts-jest": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
